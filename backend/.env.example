# Uniquement pour lancer l'API SANS Docker (voir README, "Lancer sans Docker").
# Avec Docker, ces variables sont fournies par docker-compose.yml.
# Copier en "backend/.env".

PORT=3000
JWT_SECRET=remplacer-par-une-longue-valeur-aleatoire
JWT_EXPIRES_IN=2h

# MongoDB installé sur la machine, sans mot de passe
MONGODB_URI=mongodb://localhost:27017/bobine
CATALOG_MONGODB_URI=mongodb://localhost:27017/sample_mflix
MONGODB_URI_TEST=mongodb://localhost:27017/bobine_test
CATALOG_MONGODB_URI_TEST=mongodb://localhost:27017/catalog_test

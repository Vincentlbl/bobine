# Copier ce fichier en ".env" (même dossier), puis remplacer les valeurs.
# Le fichier .env n'est jamais versionné.

# --- API ---
# Clé de signature des jetons JWT : longue et aléatoire.
# Exemple pour en générer une : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacer-par-une-longue-valeur-aleatoire
# Durée de vie d'un jeton (ex. 30m, 2h, 1d)
JWT_EXPIRES_IN=2h

# --- MongoDB ---
# Ces mots de passe sont appliqués au PREMIER démarrage du conteneur mongo.
# Pour les changer ensuite : docker compose down -v (efface les données), puis up.
# Lettres, chiffres et tirets uniquement (ils sont placés dans une URL).
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=remplacer-mot-de-passe-admin
# Compte "bobine_app" : lecture/écriture sur la base de l'application
APP_DB_PASSWORD=remplacer-mot-de-passe-application
# Compte "catalog_reader" : lecture seule sur le catalogue de films
CATALOG_DB_PASSWORD=remplacer-mot-de-passe-catalogue

# --- Déploiement (docker-compose.prod.yml) ---
# Port public du site
WEB_PORT=80
